# COPY to .env.phase5.local and edit there; NEVER commit it.
# For Docker containers, 127.0.0.1 means inside the container, not your Windows host.
# On Docker Desktop, use host.docker.internal for an existing local DB/Redis.
# Use the real values from backend/.env (with host adapted as above).
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@host.docker.internal:55433/REPLACE_DB
REDIS_URL=redis://host.docker.internal:56380/0
CORS_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
NEXT_PUBLIC_API_URL=http://127.0.0.1:18000
SESSION_COOKIE_SECURE=false
