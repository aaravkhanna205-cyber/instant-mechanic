# Production settings for compose.prod.yml.
# On the SERVER: copy to .env.prod, fill in, and run: chmod 600 .env.prod
# .env.prod is ignored by Git. Never commit it and never paste it into a chat.

# The public address of the site, without https:// (its DNS A record must point at this server).
DOMAIN=hire.example.com
# Email for HTTPS certificate notices from Let's Encrypt.
ACME_EMAIL=you@example.com

POSTGRES_USER=imhire
POSTGRES_DB=imhire
# Letters and digits only (it is placed inside a URL). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_24

# Optional: password-reset email. Leave empty to keep password reset switched off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Full https:// address of your reset-password page on this site.
RESET_URL_BASE=
