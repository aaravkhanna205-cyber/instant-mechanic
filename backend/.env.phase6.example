# Free, safe default: store approved messages in the database only.
PHASE6_DELIVERY_MODE=outbox
# To really send, set the below values privately in backend/.env or your host secrets.
# PHASE6_DELIVERY_MODE=smtp
# PHASE6_SMTP_ENABLED=YES
# PHASE6_SMTP_HOST=smtp.example.com
# PHASE6_SMTP_PORT=587
# PHASE6_SMTP_USER=service-account@example.com
# PHASE6_SMTP_PASSWORD=REPLACE_WITH_PRIVATE_APP_PASSWORD
# PHASE6_SMTP_FROM=recruitment@example.com
# Optional free local Ollama model; safe deterministic templates remain default.
# PHASE6_ENABLE_LOCAL_LLM=YES
# PHASE6_OLLAMA_MODEL=gemma3:1b

# Optional, disclose tracking to recipients; off until explicitly enabled.
PHASE6_TRACKING_ENABLED=NO
PHASE6_TRACKING_NOTICE_CONFIRMED=NO
PHASE6_OPEN_TRACKING_ENABLED=NO
PHASE6_TRACKING_PUBLIC_BASE_URL=https://your-app.example
PHASE6_TRACKING_DESTINATION=https://your-app.example/portal
